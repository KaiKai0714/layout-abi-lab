{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layout ABI compiled result record",
  "type": "object",
  "required": ["schema", "schema_version", "points"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "layoutabi_compile_v1" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "software": { "type": "object" },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resolution", "policies"],
        "additionalProperties": true,
        "properties": {
          "resolution": { "type": "integer", "minimum": 1 },
          "consumer_n": { "type": "integer" },
          "direct_over_repair_kv": { "type": ["number", "null"] },
          "policies": { "type": "object" }
        }
      }
    }
  }
}
