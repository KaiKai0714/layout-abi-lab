{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layout ABI compiled mechanism audit",
  "type": "object",
  "required": ["schema", "schema_version", "points"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "layoutabi_compile_audit_v1" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "software": { "type": "object" },
    "protocol": { "type": "object" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resolution", "policies"],
        "additionalProperties": true,
        "properties": {
          "resolution": { "type": "integer", "minimum": 1 },
          "policies": { "type": "object" }
        }
      }
    }
  }
}
